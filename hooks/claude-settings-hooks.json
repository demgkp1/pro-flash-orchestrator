{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <plugin_dir>/scripts/session-start.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <plugin_dir>/scripts/pre-invocation.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "invoke_subagent|define_subagent|send_message|manage_subagents|Task|Agent|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node <plugin_dir>/scripts/guard-subagent.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node <plugin_dir>/scripts/guard-write-file.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "read_file|view_file|view_content_chunk|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node <plugin_dir>/scripts/guard-read-file.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "run_command|Bash|shell|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node <plugin_dir>/scripts/guard-command.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
